{
	"name": "pg-lockdep",
	"version": "0.1.0",
	"description": "Finds lock-order cycles, the cause of deadlocks, in a PostgreSQL app's test suite.",
	"keywords": [
		"postgres",
		"postgresql",
		"pg",
		"deadlock",
		"lock",
		"lockdep",
		"vitest",
		"testing"
	],
	"license": "MIT",
	"author": "Serghei",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xyrolle/pg-lockdep.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"packageManager": "pnpm@11.28.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check .",
		"typecheck": "tsc",
		"test": "vitest run",
		"prepack": "pnpm build"
	},
	"peerDependencies": {
		"pg": "^8.11.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"pg": "8.23.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
